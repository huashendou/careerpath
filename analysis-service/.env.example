# 复制为 .env 再填真实值。.env 已在 .gitignore 内，不要提交。
# 生成随机密钥：py -c "import secrets;print(secrets.token_urlsafe(48))"

DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/smart_radar?charset=utf8mb4

JWT_SECRET=replace-with-a-random-48-byte-string

DEBUG=true

# 前端来源，逗号分隔
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 种子数据目录（相对 backend/）
DATA_DIR=../data
