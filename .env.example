# 复制为 .env 后填入真实值；.env 已在 .gitignore
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=career_path
DB_USERNAME=careerpath
DB_PASSWORD=<你的数据库口令>
# 至少 32 字节，python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<随机串>
# Java 与分析服务共用的内部密钥，两边必须一致
INTERNAL_TOKEN=<随机串>
ANALYSIS_BASE_URL=http://127.0.0.1:8000
